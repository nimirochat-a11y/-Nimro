.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# SECURITY (S4/S5): signing material and provider credentials must never be
# committed. These files were previously tracked and are still recoverable from
# git history — treat the leaked keys as compromised and rotate them.
android/key.properties
android/*.jks
android/*.keystore
android/app/*.jks
*.keystore
key.properties

# Local secrets injected at build time (see README)
.env
.env.*
!.env.example

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

