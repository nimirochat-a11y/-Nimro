<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- FIX(v13): this file used to parent both themes on Theme.Black. With the
         device in dark mode the Android window therefore painted BLACK behind
         and around the app, showing through as black bands and a dark launch
         frame on an otherwise white UI. The app has a single light design, so
         the night qualifier now resolves to the same light window. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#FFFFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFFFF</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#FFFFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFFFF</item>
    </style>
</resources>
